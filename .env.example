# App
WEB_PORT=3847
WEB_INTERNAL_PORT=3846
API_PORT=3848
NEXT_PUBLIC_API_BASE=

# Postgres (app database). Sandbox databases are cloned from marlow_template on this server.
DATABASE_URL=postgres://sim:sim@127.0.0.1:5432/sim
# Shown in the connection manager for people connecting from the host.
PUBLIC_PG_HOST=localhost
PUBLIC_PG_PORT=5432

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379
ENABLE_WORKER=true

# Simulated clock: sim-seconds advanced per real second while the player is active.
# 120 = two sim minutes per real second. The clock pauses after IDLE_PAUSE_MS without activity.
SIM_SPEED=120
IDLE_PAUSE_MS=90000
ALLOW_DEBUG_CLOCK=true

# Query safety
STATEMENT_TIMEOUT_MS=15000
ROW_CAP=500

# LLM. mock needs no key and keeps the project completable.
# openai | anthropic | mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_TEAMMATE=gpt-4o-mini
LLM_MODEL_MANAGER=gpt-4o-mini
LLM_SESSION_BUDGET_TOKENS=80000
HINT_SIMILARITY_THRESHOLD=0.55

# Dev-only signals page. Unset follows NODE_ENV (on outside production). The production image sets this false.
ALLOW_SIGNALS_PAGE=

# Optional telemetry sink. Events are always stored in Postgres.
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com

SESSION_TOKEN_SECRET=dev-only-change-me
